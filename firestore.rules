rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOptionalString(d, field, maxLen) {
      return !(field in d) || (d[field] is string && d[field].size() <= maxLen);
    }

    function isOptionalTime(d, field) {
      return !(field in d) || d[field] == '' || (d[field] is string && d[field].matches('^[0-9]{2}:[0-9]{2}$'));
    }

    function isOptionalPhotoUrl(d) {
      // Must be empty, or a real download URL from this project's own Storage
      // bucket -- prevents a write from pointing an event's photo at an
      // arbitrary external URL (hotlinking / tracking pixels / defacement)
      // that never went through the app's own upload flow.
      return !('photoUrl' in d) || d.photoUrl == ''
        || (d.photoUrl is string
            && d.photoUrl.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/the-monthly-table\\.firebasestorage\\.app/.*$'));
    }

    function isOptionalHash(d, field) {
      // A SHA-256 hex digest, or absent -- doesn't verify the caller KNOWS
      // the code (no auth means we can't), just that the field holds the
      // right shape rather than arbitrary data.
      return !(field in d) || (d[field] is string && d[field].matches('^[0-9a-f]{64}$'));
    }

    function isValidEvent(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.category in ['Food Distribution','Volunteer Day','Community Meal','Wellness & Care','Supply Drive']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.size() <= 40
        && d.location is string && d.location.size() > 0 && d.location.size() <= 100
        && d.hostName is string && d.hostName.size() > 0 && d.hostName.size() <= 60
        && d.description is string && d.description.size() > 0 && d.description.size() <= 400
        && d.volunteersNeeded is number && d.volunteersNeeded >= 0 && d.volunteersNeeded <= 200
        && isOptionalString(d, 'hostContact', 80)
        && isOptionalString(d, 'photoAssetId', 300)
        && isOptionalTime(d, 'startTime')
        && isOptionalTime(d, 'endTime')
        && isOptionalPhotoUrl(d)
        && isOptionalHash(d, 'editCodeHash');
    }

    match /events/{eventId} {
      // Open board: anyone can read and post, matching the site's "no login" design.
      // The 4-digit edit code / admin passphrase are UI-level friction only (documented
      // in the README, along with why they don't hold up against a motivated reader of
      // this public dataset) -- Firestore rules can't verify "this caller knows the
      // code" without real auth, so update/delete stay open here. What these rules DO
      // add: real server-side validation on create/update.
      allow read: if true;
      allow create: if isValidEvent(request.resource.data);
      allow update: if isValidEvent(request.resource.data);
      allow delete: if true;

      match /rsvps/{rsvpId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is number;
        allow update: if false;
        allow delete: if true;
      }
    }

    match /subscribers/{token} {
      // Email addresses are the one thing in this whole database that must
      // NOT be openly readable (unlike events, which are meant to be public).
      // The trick: the document id IS the subscriber's unsubscribe token, a
      // client-generated UUID (effectively unguessable). `get` (fetch one doc
      // you already have the id for) stays open because that's exactly how
      // the mailed one-click unsubscribe link works; `list` -- which would
      // let anyone dump the entire collection -- is closed. Same shape as
      // Firestore's own recommended pattern for "secret link" access.
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['email','subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subscribedAt is number;
      allow update: if false;
      allow delete: if true; // unsubscribe-by-token; same non-guessability argument as above
    }
  }
}
